  "exception": ["@@||example.com^", "@@||example.com^$document"],
  "network": ["||example.com^", "||example.com^$3p", "|http://example.com", "/pattern/", "http://example.com"],
  "domain": ["example.com", "sub.example.com", "valid-domain.co.uk", "abc.123.net", "a-b.com", "123.com"]
}
