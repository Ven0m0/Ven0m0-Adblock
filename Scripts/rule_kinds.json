{
  "blank": ["", "   "],
  "comment": ["! comment", "!!! Old Reddit", "!/disabled-rule/$doc", "# hosts comment", "; semicolon"],
  "header": ["[Adblock Plus 2.0]", "[uBlock Origin]"],
  "directive": ["!#if adguard", "!#endif", "!#else", "!#include other.txt"],
  "cosmetic": [
    "##.ad",
    "###banner",
    "example.com##.ad",
    "example.com#@#.ad",
    "a.com#?#div",
    "a.com#$#body { x: y }",
    "#%#//scriptlet"
